{
  "name": "trenches",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @trenches/web dev",
    "dev:worker": "pnpm --filter @trenches/worker dev",
    "build": "pnpm --filter @trenches/web build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "pnpm smoke:flash; pnpm smoke:arkiv; pnpm smoke:hedera",
    "smoke:flash": "tsx scripts/flash-smoke.ts",
    "smoke:arkiv": "tsx scripts/arkiv-smoke.ts",
    "smoke:hedera": "tsx scripts/hedera-smoke.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "smoke:f1": "tsx scripts/f1-smoke.ts",
    "db:migrate": "pnpm --filter @trenches/db migrate",
    "db:generate": "pnpm --filter @trenches/db generate",
    "e2e": "playwright test",
    "dev:tick": "curl -s -X POST http://localhost:3000/api/dev/tick",
    "smoke:f4": "tsx scripts/f4-smoke.ts",
    "verify": "tsx scripts/verify.ts",
    "demo": "tsx scripts/e2e-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "dotenv": "^16.4.5",
    "playwright": "1.65.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "viem": "^2.21.0",
    "vitest": "^2.1.0",
    "@playwright/test": "1.65.0"
  },
  "type": "module"
}
