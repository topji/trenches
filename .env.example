# ---- Web + API (apps/web) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trenches
DEMO_MODE=true
DEMO_SECRET=change-me
TRENCH_SALT=change-me-random
LOG_LEVEL=info

# ---- Privy ----
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- Definitive Flash ----
FLASH_API_KEY=                 # app.definitive.fi → More → Flash → Create Flash Key (fees accrue to this account)
FLASH_PLATFORM_FEE_BPS=30
TRADING_CHAIN_ID=8453
BASE_RPC_URL=https://mainnet.base.org
FLASH_SMOKE_QTY=2

# ---- World ID (IDKit 4.x) ----
NEXT_PUBLIC_WORLD_APP_ID=app_
NEXT_PUBLIC_WORLD_RP_ID=rp_
NEXT_PUBLIC_WORLD_ENVIRONMENT=staging   # staging with the simulator, production with real phones
WORLD_RP_SIGNING_KEY=                   # hex; from the Developer Portal RP setup. Server only.
WORLD_ACTION_ID=join-trench
WORLD_MOCK=true                         # hackathon: accept well-formed results carrying a server-issued nonce without calling World

# ---- Arkiv ----
ARKIV_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_WRITER_KEY=0x
ARKIV_ACCESS_KEY=

# ---- Hedera ----
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.
HEDERA_OPERATOR_KEY=            # DER from the portal (starts with 30…); raw hex also works
HEDERA_OPERATOR_KEY_TYPE=DER    # DER | ECDSA | ED25519
HEDERA_PRIZE_TOKEN_ID=          # 0.0.429274 = Circle testnet USDC; blank → hedera-smoke creates TRENCH-USDC
ESCROW_KEY_ENCRYPTION_SECRET=
ADMIN_HEDERA_ACCOUNT_ID=          # blank → hedera-smoke creates it and prints id + key
ADMIN_HEDERA_ACCOUNT_KEY=         # optional, DER; only to spend from the admin account
DEMO_WINNER_ACCOUNTS={}

# ---- Demo wallets (scripts only; rotate after the event) ----
DEMO_TRADER_A_KEY=
DEMO_TRADER_B_KEY=
